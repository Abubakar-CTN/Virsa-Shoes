import { useCallback, useState } from "react";
import {
    Heart,
    Menu,
    Search,
    ShoppingBag,
    User,
    X,
} from "lucide-react";
import { Link } from "react-router";

import AnnouncementBar from "./AnnouncementBar.jsx";
import SearchBar from "./SearchBar.jsx";
import Navbar from "./Navbar.jsx";
import MobileMenu from "./MobileMenu.jsx";
import SearchOverlay from "./SearchOverlay.jsx";

export default function Header() {
    const [searchOpen, setSearchOpen] = useState(false);
    const [mobileMenuOpen, setMobileMenuOpen] = useState(false);

    const openSearch = useCallback(() => {
        setSearchOpen(true);
        setMobileMenuOpen(false);
    }, []);

    const closeSearch = useCallback(() => {
        setSearchOpen(false);
    }, []);

    const closeMobileMenu = useCallback(() => {
        setMobileMenuOpen(false);
    }, []);

    return (
        <>
            <AnnouncementBar />

            <header className="sticky top-0 z-40 border-b border-[#E2E8F0] bg-white/95 backdrop-blur-md">
                <div className="mx-auto max-w-[1440px] px-3 sm:px-6 lg:px-8">
                    <div className="flex h-[68px] items-center gap-3 sm:h-[76px] lg:h-[84px] lg:gap-8">
                        <button
                            type="button"
                            onClick={() => setMobileMenuOpen((open) => !open)}
                            aria-label={mobileMenuOpen ? "Close navigation" : "Open navigation"}
                            aria-expanded={mobileMenuOpen}
                            aria-controls="virsa-mobile-menu"
                            className="grid size-10 shrink-0 place-items-center text-[#0F172A] transition-colors hover:bg-[#F8FAFC] hover:text-[#6D28D9] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#6D28D9] lg:hidden"
                        >
                            {mobileMenuOpen ? (
                                <X size={21} aria-hidden="true" />
                            ) : (
                                <Menu size={21} aria-hidden="true" />
                            )}
                        </button>

                        <Link
                            to="/"
                            aria-label="Virsa.Shoe home"
                            onClick={closeMobileMenu}
                            className="group flex shrink-0 flex-col leading-none"
                        >
                            <span className="text-[20px] font-extrabold tracking-[-0.055em] text-[#0F172A] transition-colors sm:text-[23px]">
                                VIRSA<span className="text-[#6D28D9]">.SHOE</span>
                            </span>

                            <span className="mt-1.5 text-[8px] font-medium tracking-[0.19em] text-slate-500 sm:text-[9px]">
                                EVERYDAY FOOTWEAR
                            </span>
                        </Link>

                        <div className="hidden min-w-0 max-w-[530px] flex-1 lg:block">
                            <SearchBar onOpen={openSearch} />
                        </div>

                        <div className="ml-auto flex shrink-0 items-center gap-1 sm:gap-2">
                            <button
                                type="button"
                                onClick={openSearch}
                                aria-label="Search products"
                                className="grid size-10 place-items-center text-[#0F172A] transition-colors hover:bg-[#F8FAFC] hover:text-[#6D28D9] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#6D28D9] lg:hidden"
                            >
                                <Search size={20} aria-hidden="true" />
                            </button>

                            <Link
                                to="/login"
                                aria-label="My account"
                                title="My account"
                                className="hidden h-10 items-center gap-2 px-2 text-sm text-[#0F172A] transition-colors hover:text-[#6D28D9] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#6D28D9] sm:inline-flex"
                            >
                                <User size={19} strokeWidth={1.7} aria-hidden="true" />
                                <span className="hidden xl:inline">Account</span>
                            </Link>

                            <Link
                                to="/wishlist"
                                aria-label="My wishlist"
                                title="Wishlist"
                                className="hidden size-10 place-items-center text-[#0F172A] transition-colors hover:bg-[#F8FAFC] hover:text-[#6D28D9] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#6D28D9] sm:grid"
                            >
                                <Heart size={19} strokeWidth={1.7} aria-hidden="true" />
                            </Link>

                            <Link
                                to="/cart"
                                aria-label="Shopping cart"
                                className="inline-flex h-10 items-center justify-center gap-2 bg-[#0F172A] px-3 text-sm font-medium text-white transition-colors hover:bg-[#6D28D9] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#6D28D9] focus-visible:ring-offset-2 sm:px-4"
                            >
                                <ShoppingBag size={18} strokeWidth={1.8} aria-hidden="true" />
                                <span className="hidden sm:inline">Cart</span>
                            </Link>
                        </div>
                    </div>
                </div>

                <Navbar />
            </header>

            <MobileMenu open={mobileMenuOpen} onClose={closeMobileMenu} />

            <SearchOverlay open={searchOpen} onClose={closeSearch} />
        </>
    );
}
