import { useMemo, useState } from "react";
import {
    ArrowDownUp,
    ArrowRight,
    Check,
    ChevronDown,
    Heart,
    Search,
    SlidersHorizontal,
    Star,
    X,
} from "lucide-react";
import { Link } from "react-router";
import products from "../../../services/mock/products.js";

const formatPrice = (price) => `Rs ${price.toLocaleString("en-PK")}`;

const categories = [...new Set(products.map((product) => product.category))].sort();

const availableSizes = [
    ...new Set(products.flatMap((product) => product.sizes)),
].sort((a, b) => Number(a) - Number(b));

function ProductCard({ product, saved, onToggleSave }) {
    const discount =
        product.comparePrice > product.price
            ? Math.round(
                  ((product.comparePrice - product.price) /
                      product.comparePrice) *
                      100
              )
            : 0;

    return (
        <article className="group min-w-0">
            <div className="relative overflow-hidden rounded-2xl bg-[#F5F0E6]">
                <Link
                    to={`/products/${product.slug}`}
                    aria-label={`View ${product.name}`}
                    className="block aspect-[4/4.5] overflow-hidden"
                >
                    <img
                        src={product.image}
                        alt={product.name}
                        loading="lazy"
                        className="size-full object-cover transition duration-500 group-hover:scale-[1.04]"
                    />
                </Link>

                <div className="absolute left-3 top-3 flex flex-wrap gap-2">
                    {product.isNew && (
                        <span className="rounded-full bg-white px-3 py-1.5 text-[9px] font-bold tracking-[0.1em] text-[#3D2A1D] shadow-sm">
                            NEW IN
                        </span>
                    )}

                    {discount > 0 && (
                        <span className="rounded-full bg-[#3D2A1D] px-3 py-1.5 text-[9px] font-bold tracking-[0.06em] text-white">
                            SAVE {discount}%
                        </span>
                    )}
                </div>

                <button
                    type="button"
                    onClick={() => onToggleSave(product.id)}
                    aria-label={
                        saved
                            ? `Remove ${product.name} from saved items`
                            : `Save ${product.name}`
                    }
                    aria-pressed={saved}
                    className={[
                        "absolute right-3 top-3 grid size-9 place-items-center rounded-full shadow-sm transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#A7833C]",
                        saved
                            ? "bg-[#3D2A1D] text-white"
                            : "bg-white/95 text-[#3D2A1D] hover:bg-[#E8CC82]",
                    ].join(" ")}
                >
                    <Heart
                        size={17}
                        fill={saved ? "currentColor" : "none"}
                        aria-hidden="true"
                    />
                </button>

                <Link
                    to={`/products/${product.slug}`}
                    className="absolute bottom-3 left-3 right-3 flex min-h-10 translate-y-2 items-center justify-center gap-2 rounded-xl bg-white/95 px-3 text-[11px] font-bold text-[#3D2A1D] opacity-0 shadow-sm transition duration-200 hover:bg-[#E8CC82] focus-visible:translate-y-0 focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#A7833C] group-hover:translate-y-0 group-hover:opacity-100"
                >
                    View product
                    <ArrowRight size={14} aria-hidden="true" />
                </Link>
            </div>

            <div className="px-1 pt-4">
                <div className="flex items-start justify-between gap-2">
                    <p className="text-[10px] font-semibold uppercase tracking-[0.12em] text-[#927A56]">
                        {product.category}
                    </p>

                    <span className="inline-flex shrink-0 items-center gap-1 text-[11px] font-semibold text-[#655441]">
                        <Star
                            size={12}
                            className="text-[#B18A3A]"
                            fill="currentColor"
                            aria-hidden="true"
                        />
                        {product.rating}
                    </span>
                </div>

                <Link
                    to={`/products/${product.slug}`}
                    className="mt-1.5 block text-sm font-semibold text-[#33251B] transition hover:text-[#8B672D]"
                >
                    {product.name}
                </Link>

                <p className="mt-1 text-[10px] text-[#978771]">
                    {product.colors.join(" / ")}
                </p>

                <div className="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span className="text-sm font-bold text-[#3D2A1D]">
                        {formatPrice(product.price)}
                    </span>

                    {product.comparePrice > product.price && (
                        <span className="text-xs text-[#9B8C78] line-through">
                            {formatPrice(product.comparePrice)}
                        </span>
                    )}
                </div>
            </div>
        </article>
    );
}

function FilterHeading({ children }) {
    return (
        <h3 className="mb-3 text-xs font-bold tracking-[0.04em] text-[#3D2A1D]">
            {children}
        </h3>
    );
}

export default function Shop() {
    const [query, setQuery] = useState("");
    const [selectedCategories, setSelectedCategories] = useState([]);
    const [selectedSizes, setSelectedSizes] = useState([]);
    const [priceBand, setPriceBand] = useState("all");
    const [sortBy, setSortBy] = useState("featured");
    const [newestOnly, setNewestOnly] = useState(false);
    const [saleOnly, setSaleOnly] = useState(false);
    const [filtersOpen, setFiltersOpen] = useState(false);
    const [savedIds, setSavedIds] = useState([]);

    const filteredProducts = useMemo(() => {
        const normalizedQuery = query.trim().toLowerCase();

        const result = products.filter((product) => {
            const matchesQuery =
                !normalizedQuery ||
                product.name.toLowerCase().includes(normalizedQuery) ||
                product.category.toLowerCase().includes(normalizedQuery) ||
                product.brand.toLowerCase().includes(normalizedQuery);

            const matchesCategory =
                selectedCategories.length === 0 ||
                selectedCategories.includes(product.category);

            const matchesSize =
                selectedSizes.length === 0 ||
                product.sizes.some((size) => selectedSizes.includes(size));

            const matchesPrice =
                priceBand === "all" ||
                (priceBand === "under5000" && product.price < 5000) ||
                (priceBand === "5000to7000" &&
                    product.price >= 5000 &&
                    product.price <= 7000) ||
                (priceBand === "over7000" && product.price > 7000);

            const matchesNew = !newestOnly || product.isNew;
            const matchesSale =
                !saleOnly || product.comparePrice > product.price;

            return (
                matchesQuery &&
                matchesCategory &&
                matchesSize &&
                matchesPrice &&
                matchesNew &&
                matchesSale
            );
        });

        return result.sort((a, b) => {
            if (sortBy === "price-low") return a.price - b.price;
            if (sortBy === "price-high") return b.price - a.price;
            if (sortBy === "rating") return b.rating - a.rating;
            if (sortBy === "newest") {
                return Number(b.isNew) - Number(a.isNew);
            }

            return (
                Number(b.isFeatured) - Number(a.isFeatured) ||
                Number(b.isPopular) - Number(a.isPopular)
            );
        });
    }, [
        query,
        selectedCategories,
        selectedSizes,
        priceBand,
        newestOnly,
        saleOnly,
        sortBy,
    ]);

    const activeFiltersCount =
        selectedCategories.length +
        selectedSizes.length +
        Number(priceBand !== "all") +
        Number(newestOnly) +
        Number(saleOnly);

    function toggleCategory(category) {
        setSelectedCategories((current) =>
            current.includes(category)
                ? current.filter((item) => item !== category)
                : [...current, category]
        );
    }

    function toggleSize(size) {
        setSelectedSizes((current) =>
            current.includes(size)
                ? current.filter((item) => item !== size)
                : [...current, size]
        );
    }

    function toggleSaved(id) {
        setSavedIds((current) =>
            current.includes(id)
                ? current.filter((item) => item !== id)
                : [...current, id]
        );
    }

    function clearFilters() {
        setQuery("");
        setSelectedCategories([]);
        setSelectedSizes([]);
        setPriceBand("all");
        setNewestOnly(false);
        setSaleOnly(false);
        setSortBy("featured");
    }

    const filtersPanel = (
        <div className="space-y-6 rounded-2xl border border-[#E9DEC9] bg-white p-5">
            <div className="flex items-center justify-between">
                <h2 className="text-sm font-bold text-[#33251B]">
                    Filter products
                </h2>

                <button
                    type="button"
                    onClick={clearFilters}
                    className="text-[11px] font-semibold text-[#89662D] underline-offset-4 hover:underline"
                >
                    Clear all
                </button>
            </div>

            <div>
                <FilterHeading>Category</FilterHeading>

                <div className="space-y-3">
                    {categories.map((category) => (
                        <label
                            key={category}
                            className="flex cursor-pointer items-center gap-3 text-xs text-[#6F604D]"
                        >
                            <input
                                type="checkbox"
                                checked={selectedCategories.includes(category)}
                                onChange={() => toggleCategory(category)}
                                className="size-4 rounded accent-[#78531F]"
                            />
                            <span className="flex-1">{category}</span>
                            <span className="text-[10px] text-[#A3937B]">
                                {products.filter((p) => p.category === category).length}
                            </span>
                        </label>
                    ))}
                </div>
            </div>

            <div className="border-t border-[#EEE5D6] pt-5">
                <FilterHeading>Price range</FilterHeading>

                <select
                    value={priceBand}
                    onChange={(event) => setPriceBand(event.target.value)}
                    className="min-h-11 w-full rounded-xl border border-[#E5DAC7] bg-[#FFFEFC] px-3 text-xs text-[#49392B] outline-none focus:border-[#A7833C] focus:ring-4 focus:ring-[#C9A34C]/15"
                    aria-label="Filter by price range"
                >
                    <option value="all">All prices</option>
                    <option value="under5000">Under Rs 5,000</option>
                    <option value="5000to7000">Rs 5,000 - Rs 7,000</option>
                    <option value="over7000">Over Rs 7,000</option>
                </select>
            </div>

            <div className="border-t border-[#EEE5D6] pt-5">
                <FilterHeading>Size (UK)</FilterHeading>

                <div className="flex flex-wrap gap-2">
                    {availableSizes.map((size) => {
                        const selected = selectedSizes.includes(size);

                        return (
                            <button
                                key={size}
                                type="button"
                                aria-pressed={selected}
                                onClick={() => toggleSize(size)}
                                className={[
                                    "grid size-10 place-items-center rounded-lg border text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C9A34C]",
                                    selected
                                        ? "border-[#3D2A1D] bg-[#3D2A1D] text-white"
                                        : "border-[#E5DAC7] bg-white text-[#655441] hover:border-[#A7833C]",
                                ].join(" ")}
                            >
                                {size}
                            </button>
                        );
                    })}
                </div>
            </div>

            <div className="space-y-3 border-t border-[#EEE5D6] pt-5">
                <label className="flex cursor-pointer items-center gap-3 text-xs text-[#6F604D]">
                    <input
                        type="checkbox"
                        checked={newestOnly}
                        onChange={(event) => setNewestOnly(event.target.checked)}
                        className="size-4 rounded accent-[#78531F]"
                    />
                    New arrivals
                </label>

                <label className="flex cursor-pointer items-center gap-3 text-xs text-[#6F604D]">
                    <input
                        type="checkbox"
                        checked={saleOnly}
                        onChange={(event) => setSaleOnly(event.target.checked)}
                        className="size-4 rounded accent-[#78531F]"
                    />
                    On sale
                </label>
            </div>
        </div>
    );

    return (
        <main className="min-h-screen bg-[#FBF8F1] pb-16">
            <section className="border-b border-[#E9DEC9] bg-[#F5EFE3]">
                <div className="mx-auto max-w-[1440px] px-5 py-10 sm:px-8 sm:py-14 lg:px-10 lg:py-16">
                    <nav
                        aria-label="Breadcrumb"
                        className="mb-6 text-[10px] font-medium text-[#8C795C]"
                    >
                        <Link to="/" className="hover:text-[#78531F]">
                            Home
                        </Link>
                        <span className="px-2">/</span>
                        <span className="text-[#3D2A1D]">Shop all</span>
                    </nav>

                    <p className="text-[10px] font-bold tracking-[0.2em] text-[#977332]">
                        THE VIRSA COLLECTION
                    </p>

                    <div className="mt-3 flex flex-col justify-between gap-5 md:flex-row md:items-end">
                        <div>
                            <h1 className="text-4xl font-semibold tracking-[-0.055em] text-[#33251B] sm:text-5xl lg:text-6xl">
                                The footwear edit.
                            </h1>

                            <p className="mt-4 max-w-xl text-sm leading-6 text-[#81715E]">
                                Discover everyday sneakers, considered formal styles
                                and comfortable pairs for your routine.
                            </p>
                        </div>

                        <p className="max-w-xs text-[11px] leading-5 text-[#8C795C]">
                            Sample catalog for this demo. Product prices, ratings
                            and availability are not live store data.
                        </p>
                    </div>
                </div>
            </section>

            <div className="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-10">
                <div className="flex flex-col gap-4 border-b border-[#E9DEC9] py-5 sm:flex-row sm:items-center sm:justify-between">
                    <div className="flex flex-1 flex-wrap items-center gap-3">
                        <div className="relative min-w-0 flex-1 sm:max-w-sm">
                            <Search
                                size={17}
                                className="absolute left-3.5 top-1/2 -translate-y-1/2 text-[#9A8A74]"
                                aria-hidden="true"
                            />

                            <input
                                type="search"
                                value={query}
                                onChange={(event) => setQuery(event.target.value)}
                                placeholder="Search footwear..."
                                aria-label="Search products"
                                className="min-h-11 w-full rounded-xl border border-[#E5DAC7] bg-white pl-10 pr-3 text-xs text-[#33251B] outline-none placeholder:text-[#A99B87] focus:border-[#A7833C] focus:ring-4 focus:ring-[#C9A34C]/15"
                            />
                        </div>

                        <button
                            type="button"
                            onClick={() => setFiltersOpen((open) => !open)}
                            aria-expanded={filtersOpen}
                            aria-controls="shop-filters"
                            className="inline-flex min-h-11 items-center gap-2 rounded-xl border border-[#DCCDAE] bg-white px-3.5 text-xs font-semibold text-[#49392B] transition hover:border-[#A7833C] lg:hidden"
                        >
                            <SlidersHorizontal size={15} aria-hidden="true" />
                            Filters
                            {activeFiltersCount > 0 && (
                                <span className="grid size-5 place-items-center rounded-full bg-[#3D2A1D] text-[10px] text-white">
                                    {activeFiltersCount}
                                </span>
                            )}
                        </button>
                    </div>

                    <div className="flex items-center justify-between gap-3 sm:justify-end">
                        <p className="text-[11px] text-[#81715E]" aria-live="polite">
                            <span className="font-bold text-[#3D2A1D]">
                                {filteredProducts.length}
                            </span>{" "}
                            {filteredProducts.length === 1 ? "style" : "styles"}
                        </p>

                        <label className="flex min-h-11 items-center gap-2 rounded-xl border border-[#E5DAC7] bg-white pl-3 pr-2">
                            <ArrowDownUp
                                size={14}
                                className="text-[#8C795C]"
                                aria-hidden="true"
                            />

                            <select
                                value={sortBy}
                                onChange={(event) => setSortBy(event.target.value)}
                                aria-label="Sort products"
                                className="max-w-[180px] bg-transparent py-2 text-xs font-semibold text-[#49392B] outline-none"
                            >
                                <option value="featured">Featured</option>
                                <option value="newest">New arrivals</option>
                                <option value="price-low">Price: low to high</option>
                                <option value="price-high">Price: high to low</option>
                                <option value="rating">Top rated</option>
                            </select>

                            <ChevronDown
                                size={14}
                                className="text-[#8C795C]"
                                aria-hidden="true"
                            />
                        </label>
                    </div>
                </div>

                <div className="grid items-start gap-7 py-7 lg:grid-cols-[245px_minmax(0,1fr)] lg:gap-9 lg:py-9">
                    <aside
                        id="shop-filters"
                        className={filtersOpen ? "block" : "hidden lg:block"}
                    >
                        <div className="mb-3 flex items-center justify-between lg:hidden">
                            <p className="text-sm font-bold text-[#33251B]">
                                Refine collection
                            </p>

                            <button
                                type="button"
                                aria-label="Close filters"
                                onClick={() => setFiltersOpen(false)}
                                className="grid size-9 place-items-center rounded-full border border-[#E9DEC9] bg-white text-[#49392B]"
                            >
                                <X size={16} aria-hidden="true" />
                            </button>
                        </div>

                        {filtersPanel}
                    </aside>

                    <section aria-label="Product results" className="min-w-0">
                        {filteredProducts.length > 0 ? (
                            <div className="grid grid-cols-1 gap-x-5 gap-y-9 min-[480px]:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
                                {filteredProducts.map((product) => (
                                    <ProductCard
                                        key={product.id}
                                        product={product}
                                        saved={savedIds.includes(product.id)}
                                        onToggleSave={toggleSaved}
                                    />
                                ))}
                            </div>
                        ) : (
                            <div className="flex min-h-80 flex-col items-center justify-center rounded-2xl border border-dashed border-[#DCCDAE] bg-white px-6 text-center">
                                <div className="grid size-12 place-items-center rounded-full bg-[#F5EFE3] text-[#78531F]">
                                    <Search size={20} aria-hidden="true" />
                                </div>

                                <h2 className="mt-4 text-lg font-semibold text-[#33251B]">
                                    No styles found
                                </h2>

                                <p className="mt-2 max-w-sm text-xs leading-6 text-[#81715E]">
                                    Try another search or remove a filter to see
                                    more footwear.
                                </p>

                                <button
                                    type="button"
                                    onClick={clearFilters}
                                    className="mt-5 inline-flex min-h-11 items-center gap-2 rounded-xl bg-[#3D2A1D] px-5 text-xs font-bold text-white transition hover:bg-[#78531F]"
                                >
                                    <Check size={15} aria-hidden="true" />
                                    Clear all filters
                                </button>
                            </div>
                        )}
                    </section>
                </div>

                <div className="border-t border-[#E9DEC9] pt-5 text-[10px] leading-5 text-[#978771]">
                    Saved hearts are temporary UI state in this demo. Wishlist
                    persistence and live inventory will be connected in later phases.
                </div>
            </div>
        </main>
    );
}