const formatMoney = (amount) =>
    `Rs ${new Intl.NumberFormat("en-PK", {
        maximumFractionDigits: 0,
    }).format(amount || 0)}`;

const formatDate = (value) => {
    if (!value) return "No orders yet";

    return new Intl.DateTimeFormat("en-PK", {
        day: "2-digit",
        month: "short",
        year: "numeric",
    }).format(new Date(`${value}T00:00:00`));
};

function CustomerAvatar({ name }) {
    const initials = name
        .split(" ")
        .map((part) => part[0])
        .slice(0, 2)
        .join("")
        .toUpperCase();

    return (
        <div
            className="grid size-10 shrink-0 place-items-center rounded-xl border border-violet-100 bg-gradient-to-br from-violet-100 to-indigo-100 text-xs font-extrabold text-violet-800"
            aria-hidden="true"
        >
            {initials}
        </div>
    );
}

function StatusBadge({ status }) {
    const active = status === "Active";

    return (
        <span
            className={[
                "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold ring-1 ring-inset",
                active
                    ? "bg-emerald-50 text-emerald-700 ring-emerald-600/20"
                    : "bg-slate-100 text-slate-600 ring-slate-500/15",
            ].join(" ")}
        >
            <span
                className={[
                    "size-1.5 rounded-full",
                    active ? "bg-emerald-500" : "bg-slate-400",
                ].join(" ")}
            />
            {status}
        </span>
    );
}

function SummaryCard({ title, value, description, icon: Icon, iconClass }) {
    return (
        <article className="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm shadow-slate-900/[0.03] transition-shadow hover:shadow-md hover:shadow-indigo-950/[0.05]">
            <div className="flex items-start justify-between gap-3">
                <div>
                    <p className="text-xs font-semibold text-slate-500">
                        {title}
                    </p>
                    <p className="mt-2 text-2xl font-extrabold tracking-tight text-slate-950">
                        {value}
                    </p>
                    <p className="mt-1.5 text-[11px] leading-5 text-slate-500">
                        {description}
                    </p>
                </div>

                <div
                    className={`grid size-11 shrink-0 place-items-center rounded-xl ${iconClass}`}
                >
                    <Icon size={20} aria-hidden="true" />
                </div>
            </div>
        </article>
    );
}

function CustomerDetails({ customer, onClose }) {
    if (!customer) return null;

    const details = [
        {
            label: "Email address",
            value: customer.email,
            icon: Mail,
        },
        {
            label: "Phone number",
            value: customer.phone,
            icon: Phone,
        },
        {
            label: "City",
            value: customer.city,
            icon: MapPin,
        },
        {
            label: "Last order",
            value: formatDate(customer.lastOrder),
            icon: CalendarDays,
        },
    ];

    return (
        <div
            className="fixed inset-0 z-[100] flex items-center justify-center overflow-y-auto bg-slate-950/55 p-4 backdrop-blur-sm"
            onClick={onClose}
        >
            <section
                role="dialog"
                aria-modal="true"
                aria-labelledby="customer-details-title"
                className="my-auto w-full max-w-lg overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl shadow-slate-950/20"
                onClick={(event) => event.stopPropagation()}
            >
                <div className="relative overflow-hidden bg-gradient-to-br from-slate-950 via-indigo-950 to-violet-900 p-6 text-white">
                    <button
                        type="button"
                        onClick={onClose}
                        aria-label="Close customer details"
                        className="absolute right-4 top-4 grid size-9 place-items-center rounded-xl border border-white/15 bg-white/10 text-white transition hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                    >
                        <X size={17} />
                    </button>

                    <div className="flex items-center gap-4 pr-9">
                        <div className="rounded-2xl bg-white p-1">
                            <CustomerAvatar name={customer.name} />
                        </div>

                        <div className="min-w-0">
                            <p className="text-[10px] font-bold uppercase tracking-[0.16em] text-violet-200">
                                Customer profile
                            </p>
                            <h2
                                id="customer-details-title"
                                className="mt-1 text-lg font-extrabold"
                            >
                                {customer.name}
                            </h2>
                            <p className="mt-1 text-xs text-indigo-100">
                                {customer.id}
                            </p>
                        </div>
                    </div>
                </div>

                <div className="space-y-5 p-5 sm:p-6">
                    <div className="flex flex-wrap items-center justify-between gap-3">
                        <StatusBadge status={customer.status} />
                        <span className="text-xs font-medium text-slate-500">
                            Customer ID: {customer.id}
                        </span>
                    </div>

                    <div className="grid grid-cols-2 gap-3">
                        <div className="rounded-2xl border border-violet-100 bg-violet-50/70 p-4">
                            <ShoppingBag
                                size={18}
                                className="text-violet-700"
                            />
                            <p className="mt-3 text-xl font-extrabold text-slate-950">
                                {customer.orders}
                            </p>
                            <p className="mt-1 text-xs text-slate-600">
                                Total orders
                            </p>
                        </div>

                        <div className="rounded-2xl border border-indigo-100 bg-indigo-50/70 p-4">
                            <Wallet size={18} className="text-indigo-700" />
                            <p className="mt-3 text-xl font-extrabold text-slate-950">
                                {formatMoney(customer.spent)}
                            </p>
                            <p className="mt-1 text-xs text-slate-600">
                                Total spend
                            </p>
                        </div>
                    </div>

                    <div className="space-y-4">
                        {details.map(({ label, value, icon: Icon }) => (
                            <div
                                key={label}
                                className="flex items-start gap-3"
                            >
                                <div className="grid size-9 shrink-0 place-items-center rounded-xl bg-slate-100 text-slate-600">
                                    <Icon size={16} />
                                </div>
                                <div className="min-w-0 flex-1">
                                    <p className="text-[11px] font-medium text-slate-500">
                                        {label}
                                    </p>
                                    <p className="mt-1 break-words text-sm font-semibold text-slate-800">
                                        {value}
                                    </p>
                                </div>
                            </div>
                        ))}
                    </div>

                    <button
                        type="button"
                        onClick={onClose}
                        className="w-full rounded-xl bg-gradient-to-r from-violet-700 to-indigo-700 px-4 py-3 text-sm font-bold text-white shadow-md shadow-indigo-900/15 transition hover:from-violet-800 hover:to-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-600"
                    >
                        Done
                    </button>
                </div>
            </section>
        </div>
    );
}

export default function Customers() {
    const [search, setSearch] = useState("");
    const [statusFilter, setStatusFilter] = useState("all");
    const [selectedCustomer, setSelectedCustomer] = useState(null);

    const filteredCustomers = useMemo(() => {
        const term = search.trim().toLowerCase();

        return DEMO_CUSTOMERS.filter((customer) => {
            const matchesSearch =
                !term ||
                [
                    customer.name,
                    customer.email,
                    customer.phone,
                    customer.city,
                    customer.id,
                ].some((value) => value.toLowerCase().includes(term));

            const matchesStatus =
                statusFilter === "all" ||
                customer.status.toLowerCase() === statusFilter;

            return matchesSearch && matchesStatus;
        });
    }, [search, statusFilter]);

    const activeCount = DEMO_CUSTOMERS.filter(
        (customer) => customer.status === "Active",
    ).length;

    const repeatCount = DEMO_CUSTOMERS.filter(
        (customer) => customer.orders > 1,
    ).length;

    const totalSpend = DEMO_CUSTOMERS.reduce(
        (total, customer) => total + customer.spent,
        0,
    );

    function exportCustomers() {
        const columns = [
            "Customer ID",
            "Name",
            "Email",
            "Phone",
            "City",
            "Orders",
            "Total Spend (PKR)",
            "Status",
            "Last Order",
        ];

        const rows = filteredCustomers.map((customer) => [
            customer.id,
            customer.name,
            customer.email,
            customer.phone,
            customer.city,
            customer.orders,
            customer.spent,
            customer.status,
            customer.lastOrder,
        ]);

        const escapeCell = (value) =>
            `"${String(value ?? "").replace(/"/g, '""')}"`;

        const csv = [columns, ...rows]
            .map((row) => row.map(escapeCell).join(","))
            .join("\r\n");

        const blob = new Blob(["\uFEFF", csv], {
            type: "text/csv;charset=utf-8;",
        });

        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");

        link.href = url;
        link.download = "virsa-demo-customers.csv";
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
    }

    return (
        <div className="mx-auto w-full max-w-[1500px] space-y-6">
            <section className="relative overflow-hidden rounded-3xl border border-indigo-900/10 bg-gradient-to-br from-slate-950 via-indigo-950 to-violet-900 p-6 text-white shadow-xl shadow-indigo-950/10 sm:p-8">
                <div
                    aria-hidden="true"
                    className="pointer-events-none absolute -right-12 -top-20 size-64 rounded-full bg-violet-500/20 blur-3xl"
                />
                <div
                    aria-hidden="true"
                    className="pointer-events-none absolute -bottom-28 right-1/3 size-60 rounded-full bg-sky-400/10 blur-3xl"
                />

                <div className="relative z-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
                    <div className="max-w-2xl">
                        <div className="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.15em] text-violet-100">
                            <Users size={13} />
                            Customer relationships
                        </div>

                        <h2 className="mt-4 text-2xl font-extrabold tracking-tight sm:text-3xl">
                            Customer Management
                        </h2>

                        <p className="mt-2 max-w-xl text-sm leading-6 text-indigo-100">
                            Review customer profiles, order activity and
                            spending in one place.
                        </p>
                    </div>

                    <button
                        type="button"
                        onClick={exportCustomers}
                        disabled={filteredCustomers.length === 0}
                        className="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-sm font-bold text-white transition hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:cursor-not-allowed disabled:opacity-50"
                    >
                        <ArrowDownToLine size={17} />
                        Export CSV
                    </button>
                </div>

                <div className="relative z-10 mt-6 flex flex-wrap items-center gap-2 text-[11px] text-indigo-100">
                    <span className="inline-flex items-center gap-1.5 rounded-full border border-amber-200/20 bg-amber-200/10 px-3 py-1.5 font-bold text-amber-100">
                        Demo data
                    </span>
                    <span>
                        Example records only — not live customer accounts.
                    </span>
                </div>
            </section>

            <section
                aria-label="Customer summary"
                className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4"
            >
                <SummaryCard
                    title="Total customers"
                    value={DEMO_CUSTOMERS.length}
                    description="Example customer profiles"
                    icon={Users}
                    iconClass="bg-violet-50 text-violet-700"
                />
                <SummaryCard
                    title="Active customers"
                    value={activeCount}
                    description="Currently marked active"
                    icon={UserCheck}
                    iconClass="bg-emerald-50 text-emerald-700"
                />
                <SummaryCard
                    title="Repeat customers"
                    value={repeatCount}
                    description="More than one order"
                    icon={ShoppingBag}
                    iconClass="bg-sky-50 text-sky-700"
                />
                <SummaryCard
                    title="Total customer spend"
                    value={formatMoney(totalSpend)}
                    description="Combined demo order spend"
                    icon={Wallet}
                    iconClass="bg-indigo-50 text-indigo-700"
                />
            </section>

            <section className="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm shadow-slate-900/[0.03]">
                <div className="flex flex-col gap-4 border-b border-slate-100 p-5 sm:p-6 lg:flex-row lg:items-center lg:justify-between">
                    <div>
                        <h3 className="text-base font-extrabold text-slate-950">
                            Customer directory
                        </h3>
                        <p className="mt-1 text-xs leading-5 text-slate-500">
                            Search customers and filter by account status.
                        </p>
                    </div>

                    <div className="flex flex-col gap-3 sm:flex-row">
                        <label className="relative block min-w-0 sm:w-72">
                            <span className="sr-only">
                                Search customers
                            </span>
                            <Search
                                size={16}
                                aria-hidden="true"
                                className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"
                            />
                            <input
                                type="search"
                                value={search}
                                onChange={(event) =>
                                    setSearch(event.target.value)
                                }
                                placeholder="Name, email, city or ID"
                                className="min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/70 py-2.5 pl-10 pr-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-violet-400 focus:bg-white focus:ring-4 focus:ring-violet-500/10"
                            />
                        </label>

                        <label className="relative block sm:w-40">
                            <span className="sr-only">
                                Filter by customer status
                            </span>
                            <select
                                value={statusFilter}
                                onChange={(event) =>
                                    setStatusFilter(event.target.value)
                                }
                                className="min-h-11 w-full appearance-none rounded-xl border border-slate-200 bg-white px-3.5 pr-9 text-sm font-semibold text-slate-700 outline-none transition focus:border-violet-400 focus:ring-4 focus:ring-violet-500/10"
                            >
                                <option value="all">All statuses</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </label>
                    </div>
                </div>

                <div className="flex flex-wrap items-center justify-between gap-2 px-5 py-3 sm:px-6">
                    <p className="text-xs text-slate-500">
                        Showing{" "}
                        <span className="font-bold text-slate-800">
                            {filteredCustomers.length}
                        </span>{" "}
                        of {DEMO_CUSTOMERS.length} customers
                    </p>

                    {(search || statusFilter !== "all") && (
                        <button
                            type="button"
                            onClick={() => {
                                setSearch("");
                                setStatusFilter("all");
                            }}
                            className="text-xs font-bold text-violet-700 transition hover:text-indigo-800"
                        >
                            Clear filters
                        </button>
                    )}
                </div>

                <div className="overflow-x-auto">
                    <table className="w-full min-w-[850px] border-collapse text-left">
                        <thead>
                            <tr className="border-y border-slate-100 bg-slate-50/80">
                                <th className="px-6 py-3.5 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                                    Customer
                                </th>
                                <th className="px-4 py-3.5 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                                    Location
                                </th>
                                <th className="px-4 py-3.5 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                                    Orders
                                </th>
                                <th className="px-4 py-3.5 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                                    Total spend
                                </th>
                                <th className="px-4 py-3.5 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                                    Last order
                                </th>
                                <th className="px-4 py-3.5 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                                    Status
                                </th>
                                <th className="px-6 py-3.5 text-right text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">
                                    Details
                                </th>
                            </tr>
                        </thead>

                        <tbody className="divide-y divide-slate-100">
                            {filteredCustomers.map((customer) => (
                                <tr
                                    key={customer.id}
                                    className="transition-colors hover:bg-violet-50/30"
                                >
                                    <td className="px-6 py-4">
                                        <div className="flex items-center gap-3">
                                            <CustomerAvatar
                                                name={customer.name}
                                            />
                                            <div className="min-w-0">
                                                <p className="whitespace-nowrap text-sm font-bold text-slate-900">
                                                    {customer.name}
                                                </p>
                                                <p className="mt-1 whitespace-nowrap text-xs text-slate-500">
                                                    {customer.email}
                                                </p>
                                                <p className="mt-1 text-[10px] font-semibold text-violet-700">
                                                    {customer.id}
                                                </p>
                                            </div>
                                        </div>
                                    </td>

                                    <td className="px-4 py-4">
                                        <div className="flex items-center gap-1.5 whitespace-nowrap text-xs font-medium text-slate-600">
                                            <MapPin
                                                size={13}
                                                className="text-slate-400"
                                            />
                                            {customer.city}
                                        </div>
                                    </td>

                                    <td className="px-4 py-4 text-sm font-bold tabular-nums text-slate-800">
                                        {customer.orders}
                                    </td>

                                    <td className="px-4 py-4 whitespace-nowrap text-sm font-bold tabular-nums text-slate-900">
                                        {formatMoney(customer.spent)}
                                    </td>

                                    <td className="px-4 py-4 whitespace-nowrap text-xs text-slate-600">
                                        {formatDate(customer.lastOrder)}
                                    </td>

                                    <td className="px-4 py-4">
                                        <StatusBadge
                                            status={customer.status}
                                        />
                                    </td>

                                    <td className="px-6 py-4 text-right">
                                        <button
                                            type="button"
                                            onClick={() =>
                                                setSelectedCustomer(customer)
                                            }
                                            aria-label={`View details for ${customer.name}`}
                                            className="rounded-lg border border-violet-100 bg-violet-50 px-3 py-2 text-xs font-bold text-violet-800 transition hover:border-violet-200 hover:bg-violet-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-600"
                                        >
                                            View details
                                        </button>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>

                {filteredCustomers.length === 0 && (
                    <div className="px-5 py-14 text-center sm:px-8">
                        <div className="mx-auto grid size-12 place-items-center rounded-2xl bg-violet-50 text-violet-700">
                            <CircleUserRound size={23} />
                        </div>
                        <h4 className="mt-4 text-sm font-bold text-slate-900">
                            No customers found
                        </h4>
                        <p className="mx-auto mt-1 max-w-sm text-xs leading-5 text-slate-500">
                            Try another search term or clear your selected
                            filters.
                        </p>
                        <button
                            type="button"
                            onClick={() => {
                                setSearch("");
                                setStatusFilter("all");
                            }}
                            className="mt-4 rounded-xl bg-gradient-to-r from-violet-700 to-indigo-700 px-4 py-2.5 text-xs font-bold text-white transition hover:from-violet-800 hover:to-indigo-800"
                        >
                            Reset filters
                        </button>
                    </div>
                )}

                <div className="flex flex-wrap items-center gap-2 border-t border-slate-100 bg-slate-50/60 px-5 py-3.5 sm:px-6">
                    <span className="size-2 rounded-full bg-amber-400" />
                    <p className="text-[11px] leading-5 text-slate-500">
                        Sample customer records for frontend development.
                        Connect the customer API to display real store data.
                    </p>
                </div>
            </section>

            <CustomerDetails
                customer={selectedCustomer}
                onClose={() => setSelectedCustomer(null)}
            />
        </div>
    );
}