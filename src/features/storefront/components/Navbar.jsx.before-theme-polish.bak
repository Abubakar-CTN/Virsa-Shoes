import { useState } from "react";
import { ArrowRight, ChevronDown } from "lucide-react";
import { Link } from "react-router";

import { storefrontNavigation } from "../../../config/navigation.js";

export default function Navbar() {
    const [openMenu, setOpenMenu] = useState(null);

    const activeItem = storefrontNavigation.find(
        (item) => item.label === openMenu && item.groups,
    );

    return (
        <nav
            aria-label="Main navigation"
            className="relative hidden border-t border-[#E2E8F0] bg-white lg:block"
        >
            <div
                className="relative mx-auto max-w-[1440px] px-6 lg:px-8"
                onMouseLeave={() => setOpenMenu(null)}
                onKeyDown={(event) => {
                    if (event.key === "Escape") setOpenMenu(null);
                }}
            >
                <div className="flex h-[47px] items-center justify-between gap-5">
                    {storefrontNavigation.map((item) => (
                        <div key={item.label} className="flex h-full items-center">
                            <Link
                                to={item.to}
                                onMouseEnter={() => setOpenMenu(item.groups ? item.label : null)}
                                onFocus={() => setOpenMenu(item.groups ? item.label : null)}
                                onClick={() => setOpenMenu(null)}
                                aria-haspopup={item.groups ? "true" : undefined}
                                aria-expanded={item.groups ? openMenu === item.label : undefined}
                                className={[
                                    "relative inline-flex h-full items-center gap-1.5 text-[11px] font-semibold tracking-[0.09em] transition-colors",
                                    "after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:bg-[#6D28D9] after:transition-transform",
                                    "hover:text-[#6D28D9] hover:after:scale-x-100 focus-visible:outline-none focus-visible:text-[#6D28D9]",
                                    item.sale ? "text-rose-700" : "text-[#0F172A]",
                                ].join(" ")}
                            >
                                {item.label}

                                {item.groups && (
                                    <ChevronDown
                                        size={13}
                                        className={[
                                            "transition-transform duration-200",
                                            openMenu === item.label ? "rotate-180" : "",
                                        ].join(" ")}
                                        aria-hidden="true"
                                    />
                                )}
                            </Link>
                        </div>
                    ))}
                </div>

                {activeItem && (
                    <div
                        className="absolute left-1/2 top-full z-50 w-[760px] max-w-[calc(100vw-32px)] -translate-x-1/2 border border-[#E2E8F0] bg-white shadow-[0_18px_45px_rgba(15,23,42,0.12)]"
                        onMouseEnter={() => setOpenMenu(activeItem.label)}
                    >
                        <div className="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_210px] gap-6 p-6">
                            {activeItem.groups.map((group) => (
                                <div key={group.title}>
                                    <h3 className="mb-4 text-[10px] font-bold tracking-[0.15em] text-slate-500">
                                        {group.title}
                                    </h3>

                                    <ul className="space-y-3">
                                        {group.links.map((link) => (
                                            <li key={link.label}>
                                                <Link
                                                    to={link.to}
                                                    onClick={() => setOpenMenu(null)}
                                                    className="text-[13px] text-slate-700 transition-colors hover:text-[#6D28D9] focus-visible:outline-none focus-visible:text-[#6D28D9]"
                                                >
                                                    {link.label}
                                                </Link>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))}

                            <div className="flex flex-col justify-between bg-[#F8FAFC] p-5">
                                <div>
                                    <p className="text-[10px] font-semibold tracking-[0.15em] text-[#6D28D9]">
                                        THE VIRSA EDIT
                                    </p>

                                    <h3 className="mt-3 text-[21px] font-semibold leading-tight tracking-[-0.04em] text-[#0F172A]">
                                        Find your everyday pair.
                                    </h3>

                                    <p className="mt-3 text-xs leading-5 text-slate-600">
                                        Explore footwear for work, weekends and everything between.
                                    </p>
                                </div>

                                <Link
                                    to="/shop"
                                    onClick={() => setOpenMenu(null)}
                                    className="mt-5 inline-flex items-center gap-2 text-xs font-semibold text-[#0F172A] transition-colors hover:text-[#6D28D9]"
                                >
                                    Shop all footwear
                                    <ArrowRight size={14} aria-hidden="true" />
                                </Link>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </nav>
    );
}
