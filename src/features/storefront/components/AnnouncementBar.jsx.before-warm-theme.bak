import { ArrowRight } from "lucide-react";
import { Link } from "react-router";

const messages = [
    "THE VIRSA EDIT",
    "Everyday footwear, considered.",
    "Find your next everyday pair.",
    "Discover the collection",
];

export default function AnnouncementBar() {
    return (
        <div className="overflow-hidden bg-gradient-to-r from-[#4C1D95] via-[#6D28D9] to-[#1D4ED8] text-white">
            <p className="sr-only">
                Explore Virsa.Shoe footwear collections and discover your everyday style.
            </p>

            <div className="virsa-marquee-viewport" aria-hidden="true">
                <div className="virsa-marquee-track">
                    {[0, 1].map((copy) => (
                        <div key={copy} className="virsa-marquee-group">
                            {messages.map((message, index) => (
                                <span
                                    key={`${copy}-${message}`}
                                    className="inline-flex shrink-0 items-center gap-3"
                                >
                                    {index === 0 ? (
                                        <span className="font-bold tracking-[0.15em]">
                                            {message}
                                        </span>
                                    ) : (
                                        <span className="font-medium text-white/90">
                                            {message}
                                        </span>
                                    )}

                                    <span className="size-1 rounded-full bg-sky-300" />
                                </span>
                            ))}

                            <span className="inline-flex items-center gap-2 font-semibold text-sky-200">
                                THE VIRSA EDIT
                                <ArrowRight size={12} aria-hidden="true" />
                            </span>
                        </div>
                    ))}
                </div>
            </div>

            <Link
                to="/shop?sort=new"
                className="sr-only"
            >
                Explore new arrivals
            </Link>
        </div>
    );
}
